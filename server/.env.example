# 数据库
DATABASE_URL="file:./dev.db"

# 服务器配置
PORT=3001
CLIENT_URL=http://localhost:5174

# 热点监控配置
# 新鲜度过滤：保留最近多少小时内的内容（默认 168 小时 = 7 天）
HOTSPOT_MAX_AGE_HOURS=168
# Twitter 配额：每个关键词最多处理多少条 Twitter 内容
HOTSPOT_TWITTER_QUOTA=15
# 其他来源配额：每个关键词最多处理多少条其他来源内容
HOTSPOT_OTHER_QUOTA=10

# Minimax AI (Anthropic API 兼容)
MINIMAX_API_KEY=your_minimax_api_key_here

# Twitter API (twitterapi.io)
TWITTER_API_KEY=your_twitter_api_key_here

# 邮件通知 (可选)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
NOTIFY_EMAIL=notify_to@example.com
