# 数据库
DATABASE_URL="file:./prod.db"

# 服务器配置
PORT=3001
CLIENT_URL=https://你的域名

# Redis (生产环境建议配置 - 用于分布式限流)
REDIS_URL=redis://localhost:6379

# OpenRouter AI (生产环境请使用真实密钥)
OPENROUTER_API_KEY=你的OPENROUTER_API_KEY

# Twitter API (可选)
TWITTER_API_KEY=

# 邮件通知 (可选)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# 安全配置
NODE_ENV=production
